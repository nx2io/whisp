{
  "name": "whisp",
  "version": "0.1.0",
  "description": "Offline audio and video transcriber for Linux. Drop a file in, get text out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyrazolabs/Whisp.git"
  },
  "homepage": "https://github.com/kyrazolabs/Whisp#readme",
  "bugs": {
    "url": "https://github.com/kyrazolabs/Whisp/issues"
  },
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.0",
  "scripts": {
    "dev": "vite build && concurrently -k -n vite,electrobun \"vite build --watch\" \"cross-env CES_DEV_RELOAD=1 electrobun dev\"",
    "build": "vite build && electrobun build --env=dev --targets=current",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@tanstack/react-router": "^1.166.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "^1.16.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/router-plugin": "^1.166.6",
    "@types/bun": "^1.3.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
